# Security headers — Netlify & Cloudflare Pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: on
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; manifest-src 'self'; media-src 'self'; form-action 'self'; frame-src 'self' https://maps.google.com https://www.google.com; upgrade-insecure-requests
  X-Permitted-Cross-Domain-Policies: none

# Long-lived caching for immutable assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Override for CSS and JS: they are edited in place (there is no build step that
# hashes filenames), so returning visitors must revalidate or they keep the old
# stylesheet and scripts. Later rules win, so these take precedence above.
/assets/css/*
  Cache-Control: public, max-age=600, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=600, must-revalidate
/favicon.*
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
